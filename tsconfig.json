{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "outDir": "dist",
    "types": ["node", "playwright"]
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "pages/**/*.ts"],
  "exclude": ["node_modules"]
}
