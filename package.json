{
  "name": "web-automation-testing",
  "version": "2.0.0",
  "description": "AI-Powered Autonomous Test Automation Platform for Web Applications",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:all": "playwright test tests/generated/specs",
    "ai": "node ai-agent2.js",
    "typecheck": "tsc --noEmit",
    "report": "allure generate ./allure-results -o ./allure-report --clean && allure open ./allure-report"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "ai",
    "bdd"
  ],
