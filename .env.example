# Bu dosyayı .env olarak kopyalayıp doldurun (.env gitignore'dadır, commit edilmez).

# ==========================================================================
# LLM (Ollama) AYARLARI — ZORUNLU
# Bu iki değişken tanımlı değilse sunucu ve CLI açılışta hata verip durur.
# ==========================================================================
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://127.0.0.1:11434/api/chat
# Daha güçlü bir makinedeki Ollama'yı kullanmak için (o makinede
# `OLLAMA_HOST=0.0.0.0 ollama serve` çalıştırılıp model çekilmiş olmalı):
# OLLAMA_MODEL=qwen2.5-coder:32b
# OLLAMA_URL=http://<sunucu-ip>:11434/api/chat

# Model bağlam penceresi (token). Ollama bu sınırı aşan istemi HATA VERMEDEN
# baştan kırpar. 8192 çoğu sayfa için yeterlidir; RAM azsa 4096'ya düşürülebilir.
# OLLAMA_NUM_CTX=8192

# Tek bir LLM çağrısının azami süresi (ms). GPU'suz yavaş makinelerde artırın.
# LLM_TIMEOUT_MS=120000

# ==========================================================================
# SUNUCU VE ERİŞİM
# ==========================================================================
# Arayüzün dinleyeceği port.
# PORT=3000

# Sunucunun bağlanacağı adres. Varsayılan 127.0.0.1: arayüz YALNIZCA bu
# makineden açılır. Ağdaki başka makinelerden erişilecekse 0.0.0.0 yapın
# VE aşağıdaki APP_TOKEN'ı mutlaka doldurun.
# HOST=127.0.0.1

# 🔐 Erişim anahtarı. TANIMLIYSA arayüz, Socket.io bağlantısı, dosya yükleme ve
# Allure raporu bu anahtarı ister. Boş bırakılırsa koruma KAPALIDIR. Ağa açık
# kullanımda mutlaka doldurun (örn. `openssl rand -hex 24` çıktısı).
# APP_TOKEN=

# Arayüzden seçilebilecek test klasörlerini tek bir kök dizinin altına kısıtlar.
# QA_ALLOWED_ROOT=C:\QA-Testlerim

# ==========================================================================
# HEDEF ADRES POLİTİKASI
# Varsayılan: iç ağ (localhost, 10.x, 192.168.x, kurum içi alan adları) SERBEST —
# aracın asıl amacı kurumun kendi test/staging ortamlarını test etmektir.
# ==========================================================================
# Yalnızca bu alan adlarına izin ver (virgülle ayrılmış, *. joker desteklenir):
# QA_ALLOWED_HOSTS=*.kurum.local,test.ornek.com.tr
# Sunucu ağa açılıp paylaşılıyorsa iç ağ / loopback adreslerini tamamen kapat:
# QA_BLOCK_PRIVATE_URLS=true

# Kurum içi test ortamı kendinden imzalı (self-signed) HTTPS sertifikası kullanıyorsa.
# Yalnızca güvenilen iç ortamlar için açın.
# IGNORE_HTTPS_ERRORS=true

# ==========================================================================
# GİZLİ TEST VERİLERİ (şifre, PIN, API anahtarı)
# QA_SECRET_ önekiyle tanımlanır. Senaryoda {{QA_SECRET_PASSWORD}} gibi yer
# tutucuyla kullanılır; üretilen testlere düz metin olarak YAZILMAZ, testler
# koşarken değeri buradan okur. Loglarda da maskelenir.
# ==========================================================================
# QA_SECRET_PASSWORD=
# QA_SECRET_ADMIN_PASSWORD=

# ==========================================================================
# KAYITLI OTURUM (SSO / MFA / SMS-OTP ile korunan uygulamalar)
# Otomatikleştirilemeyen girişler için bir kez elle giriş yapıp oturumu kaydedin:
#   npx playwright codegen --save-storage=auth/oturum.json https://uygulama.kurum.local
# Keşif ve üretilen tüm testler bu oturumla (giriş yapılmış olarak) başlar.
# Oturum dosyası gizli bilgi içerir; auth/ klasörü .gitignore'dadır.
# ==========================================================================
# STORAGE_STATE=auth/oturum.json

# ==========================================================================
# UZAK TARAYICI / GRID
# --grid bayrağı veya arayüzdeki "Uzak Sunucuda Çalıştır" seçeneği ile aktif olur.
# NOT: chromium.connect PLAYWRIGHT protokolü ister; vanilla Selenium Grid 4 uymaz.
# Aerokube Moon ya da `npx playwright run-server` kullanın.
# ==========================================================================
# GRID_WS_ENDPOINT=ws://localhost:4444/playwright/chromium
# Başka bir makinede `npx playwright run-server --port 4444` çalıştırılıyorsa:
# GRID_WS_ENDPOINT=ws://<sunucu-ip>:4444/

# ==========================================================================
# TEST KOŞUMU VE MEDYA KAYDI
# ==========================================================================
SAVE_VIDEO=off
SAVE_SCREENSHOT=only-on-failure

# Paralel test koşumunda kullanılacak worker sayısı (boşsa Playwright CPU'ya göre seçer).
# PW_WORKERS=4

# Başarısız testin otomatik yeniden deneme sayısı (varsayılan 0: hatalar gizlenmesin).
# PW_RETRIES=1

# Playwright'ın baseURL olarak kullanacağı adres (opsiyonel)
# BASE_URL=

# ==========================================================================
# AI KEŞİF DÖNGÜSÜ AYARLARI (opsiyonel — varsayılanlar çoğu senaryo için yeterli)
# ==========================================================================
# LLM'e gönderilecek azami DOM eleman sayısı.
# MAX_DOM_ELEMENTS=60

# Kırık bir locator için azami self-healing kurtarma turu.
# MAX_HEAL_ATTEMPTS=2

# Keşif döngüsünün azami adım sayısı. Uzun iş akışlarında artırın.
# MAX_DISCOVERY_LOOPS=25

# Her eylemden sonra sayfanın durulması için beklenecek azami süre (ms).
# STEP_SETTLE_MS=3000

# Tek bir tıklama/doldurma işleminin azami süresi (ms).
# ACTION_TIMEOUT_MS=10000

# Keşif fazı varsayılan olarak GÖRÜNÜR bir tarayıcıda koşar (süreci izleyebilmek için).
# Ekransız ortamlarda (SSH, Docker, sunucu) true yapın.
# HEADLESS=false
